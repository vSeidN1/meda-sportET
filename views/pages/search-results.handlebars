<div class="container py-5">
  <div class="mb-5 text-center">
    <h2 class="fw-bold"><i class="bi bi-search text-primary me-2"></i> Search Results</h2>
    <p class="lead text-muted">Showing results for "<strong class="text-primary">{{query}}</strong>"</p>
  </div>

  {{#if noResults}}
    <div class="card p-5 text-center shadow-sm max-width-600 mx-auto border-0">
      <div class="card-body">
        <div class="fs-1 text-secondary mb-3"><i class="bi bi-patch-question"></i></div>
        <h4 class="fw-bold mb-2">No Results Found</h4>
        <p class="text-muted mb-4">We couldn't find anything matching your search. Try double checking your spelling or using different keywords.</p>
        <a href="/" class="btn btn-primary px-4 py-2 rounded-pill"><i class="bi bi-house-door-fill me-2"></i> Back to Home</a>
      </div>
    </div>
  {{else}}
    <div class="row">
      <!-- News Results Section -->
      <div class="col-lg-6 mb-5">
        <div class="d-flex align-items-center mb-4">
          <h4 class="fw-bold m-0"><i class="bi bi-newspaper text-primary me-2"></i> News Articles</h4>
          <span class="badge bg-primary ms-2 rounded-pill">{{newsResults.length}}</span>
        </div>
        <hr class="mt-0 mb-4 border-2">

        {{#if newsResults.length}}
          <div class="row row-cols-1 g-4">
            {{#each newsResults}}
              <div class="col">
                <div class="card h-100 news-card flex-row overflow-hidden">
                  <div class="col-4 p-0">
                    <img src="{{this.image}}" class="w-100 h-100" style="object-fit: cover; min-height: 120px;" alt="...">
                  </div>
                  <div class="col-8 card-body d-flex flex-column justify-content-between p-3">
                    <div>
                      <span class="badge bg-secondary mb-2" style="font-size: 0.75rem;">{{this.category}}</span>
                      <h6 class="card-title fw-bold text-truncate mb-1">{{this.title}}</h6>
                      <p class="card-text text-muted small mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        {{this.summary}}
                      </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                      <div class="d-flex gap-2 align-items-center">
                        <span class="text-muted small" title="Views"><i class="bi bi-eye"></i> {{this.views}}</span>
                        <span class="text-muted small" title="Likes"><i class="bi bi-heart-fill text-danger"></i> {{this.likes}}</span>
                        <span class="text-muted small ms-1" title="Author"><i class="bi bi-person-fill"></i> {{this.author}}</span>
                      </div>
                      <a href="/news/{{this.id}}" class="btn btn-sm btn-outline-primary rounded-pill px-3">Read</a>
                    </div>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="text-muted">No news articles match your search query.</p>
        {{/if}}
      </div>

      <!-- Highlights Results Section -->
      <div class="col-lg-6 mb-5">
        <div class="d-flex align-items-center mb-4">
          <h4 class="fw-bold m-0"><i class="bi bi-play-circle-fill text-danger me-2"></i> Match Highlights</h4>
          <span class="badge bg-danger ms-2 rounded-pill">{{highlightResults.length}}</span>
        </div>
        <hr class="mt-0 mb-4 border-2">

        {{#if highlightResults.length}}
          <div class="row row-cols-1 g-4">
            {{#each highlightResults}}
              <div class="col">
                <div class="card h-100 news-card flex-row overflow-hidden">
                  <div class="col-4 bg-dark d-flex align-items-center justify-content-center p-0" style="position: relative;">
                    <!-- A neat placeholder play icon for video -->
                    <i class="bi bi-play-btn-fill text-white fs-1" style="opacity: 0.8;"></i>
                  </div>
                  <div class="col-8 card-body d-flex flex-column justify-content-between p-3">
                    <div>
                      <h6 class="card-title fw-bold text-truncate mb-1">{{this.title}}</h6>
                      <p class="card-text text-muted small mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        {{this.description}}
                      </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                      <div class="d-flex gap-2">
                        <span class="text-muted small"><i class="bi bi-eye"></i> {{this.views}}</span>
                        <span class="text-muted small"><i class="bi bi-heart-fill text-danger"></i> {{this.likes}}</span>
                      </div>
                      <a href="/highlights/{{this.id}}" class="btn btn-sm btn-outline-danger rounded-pill px-3">Watch</a>
                    </div>
                  </div>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="text-muted">No match highlights match your search query.</p>
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>
