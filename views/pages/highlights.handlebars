<div class="container mt-5">
  <div class="mb-5 text-center">
    <h2 class="fw-bold"><i class="bi bi-play-circle-fill text-danger me-2"></i> Match Highlights</h2>
    <p class="lead text-muted">Relive the most exciting football moments ⚽🔥</p>
  </div>
  <div class="row">
    {{#each highlights}}
      <div class="col-md-6 mb-4 animate__animated animate__fadeInUp">
        <div class="card news-card shadow-lg h-100 border-0">
          <div class="ratio ratio-16x9 bg-dark d-flex align-items-center justify-content-center" style="position: relative;">
            <iframe
              src="{{this.youtube_link}}"
              title="{{this.title}}"
              allowfullscreen
              style="border-top-left-radius: 16px; border-top-right-radius: 16px;"
              loading="lazy"
            ></iframe>
          </div>
          <div class="card-body d-flex flex-column justify-content-between p-4">
            <div>
              <h5 class="card-title fw-bold text-truncate mb-2">{{this.title}}</h5>
              <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                {{this.description}}
              </p>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
              <div class="d-flex gap-3">
                <span class="text-secondary small" title="Views"><i class="bi bi-eye"></i> {{this.views}}</span>
                <span class="text-secondary small" title="Likes"><i class="bi bi-heart-fill text-danger"></i> {{this.likes}}</span>
              </div>
              <a href="/highlights/{{this.id}}" class="btn btn-sm btn-outline-danger rounded-pill px-4 py-2 fw-semibold">
                Watch & Discuss <i class="bi bi-chat-dots-fill ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>