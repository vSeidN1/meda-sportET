<div class="competition-main-card fade-in">
  <ul
    class="nav nav-tabs competition-nav-tabs mb-3 flex-nowrap overflow-auto"
    id="competitionTabs"
    role="tablist"
  >
    <li class="nav-item">
      <button
        class="nav-link active"
        id="titles-tab"
        data-bs-toggle="tab"
        data-bs-target="#titles"
        type="button"
        role="tab"
      >🏆 Most Titles</button>
    </li>
    <li class="nav-item">
      <button
        class="nav-link"
        id="scorers-tab"
        data-bs-toggle="tab"
        data-bs-target="#scorers"
        type="button"
        role="tab"
      >⚽ Top goal Scorers</button>
    </li>
    <li class="nav-item">
      <button
        class="nav-link"
        id="assists-tab"
        data-bs-toggle="tab"
        data-bs-target="#assists"
        type="button"
        role="tab"
      >🎯 Most Assists</button>
    </li>
    <li class="nav-item">
      <button
        class="nav-link"
        id="hattricks-tab"
        data-bs-toggle="tab"
        data-bs-target="#hattricks"
        type="button"
        role="tab"
      >🔥 Most Hat-tricks</button>
    </li>
    <li class="nav-item">
      <button
        class="nav-link"
        id="freekicks-tab"
        data-bs-toggle="tab"
        data-bs-target="#freekicks"
        type="button"
        role="tab"
      >🎯 Most Free-kicks</button>
    </li>
    <li class="nav-item">
      <button
        class="nav-link"
        id="keepers-tab"
        data-bs-toggle="tab"
        data-bs-target="#keepers"
        type="button"
        role="tab"
      >🧤 Legendary Keepers</button>
    </li>
  </ul>

  <div class="tab-content" id="competitionTabsContent">
    <div class="tab-pane fade show active" id="titles" role="tabpanel">
      {{#each titles}}
        <div class="competition-inner-card">
          <h5>{{club_name}}</h5>
          <p><strong>Titles:</strong> {{titles}}</p>
        </div>
      {{/each}}
    </div>

    <div class="tab-pane fade" id="scorers" role="tabpanel">
      {{#each scorers}}
        <div class="competition-inner-card">
          <h5>{{player_name}}</h5>
          <p>{{club_name}}</p>
          <p><strong>Goals:</strong> {{goals}}</p>
        </div>
      {{/each}}
    </div>

    <div class="tab-pane fade" id="assists" role="tabpanel">
      {{#each assists}}
        <div class="competition-inner-card">
          <h5>{{player_name}}</h5>
          <p>{{club_name}}</p>
          <p><strong>Assists:</strong> {{assists}}</p>
        </div>
      {{/each}}
    </div>

    <div class="tab-pane fade" id="hattricks" role="tabpanel">
      {{#each hattricks}}
        <div class="competition-inner-card">
          <h5>{{player_name}}</h5>
          <p>{{club_name}}</p>
          <p><strong>Hat-tricks:</strong> {{hattricks}}</p>
        </div>
      {{/each}}
    </div>

    <div class="tab-pane fade" id="freekicks" role="tabpanel">
      {{#each freekicks}}
        <div class="competition-inner-card">
          <h5>{{player_name}}</h5>
          <p>{{club_name}}</p>
          <p><strong>Free-kick Goals:</strong> {{freekick_goals}}</p>
        </div>
      {{/each}}
    </div>

    <div class="tab-pane fade" id="keepers" role="tabpanel">
      {{#each keepers}}
        <div class="competition-inner-card">
          <h5>{{player_name}}</h5>
          <p>{{club_name}}</p>
          <p><strong>Clean Sheets:</strong> {{clean_sheets}}</p>
        </div>
      {{/each}}
    </div>
  </div>
</div>
